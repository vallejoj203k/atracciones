# ---------------------------------------------------------------------------
# Backend (server/)
# ---------------------------------------------------------------------------

# Cadena de conexion a PostgreSQL. En Railway se inyecta automaticamente
# como DATABASE_URL al enlazar el plugin de Postgres.
DATABASE_URL="postgresql://mirador:mirador@localhost:5432/mirador?schema=public"

# Puerto HTTP del backend.
PORT=4000

# Entorno: development | production | test
NODE_ENV=development

# Secreto para firmar los JWT. OBLIGATORIO en produccion: minimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-min-32-chars"

# Vigencia del token de sesion. Las estaciones de atraccion son dispositivos
# fijos, por eso conviene una vigencia larga (ej. 30d).
JWT_EXPIRES_IN="30d"

# Origenes permitidos para CORS, separados por coma.
# Dejar vacio o "*" permite cualquier origen (solo recomendable en desarrollo).
CORS_ORIGIN="http://localhost:5173"

# Servir el frontend compilado (web/dist) desde el mismo proceso Express.
# true  -> un solo servicio en Railway (recomendado y mas barato)
# false -> frontend y backend desplegados por separado
SERVE_WEB=true

# Credenciales del administrador inicial creado por el seed.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="cambiar123"
SEED_ADMIN_NOMBRE="Administrador"

# ---------------------------------------------------------------------------
# Pasarela de pago (fase 2 - hoy la confirmacion del pago digital es manual)
# ---------------------------------------------------------------------------

# manual | wompi
PAGOS_PROVEEDOR=manual

# Solo se usan cuando PAGOS_PROVEEDOR=wompi
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_EVENTS_SECRET=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_BASE_URL="https://production.wompi.co/v1"

# ---------------------------------------------------------------------------
# Frontend (web/) - variables de build de Vite
# ---------------------------------------------------------------------------

# URL base de la API. Dejar vacio cuando el backend sirve el frontend
# (SERVE_WEB=true), porque entonces la API vive en el mismo origen.
VITE_API_URL=""
